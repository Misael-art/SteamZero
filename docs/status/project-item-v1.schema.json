{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamzero.local/schemas/project-item-v1.schema.json",
  "title": "SteamZero project status item v1",
  "oneOf": [
    {"$ref": "#/$defs/item"},
    {"$ref": "#/$defs/workstream"}
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "kind", "id", "title", "domain", "implementation",
        "integration", "verification", "operation", "distribution", "scopePaths",
        "dependsOn", "knownGaps", "acceptanceCriteria", "evidence", "nextAction",
        "activeWorkstreams", "updatedAt", "notes"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "project-item"},
        "id": {"type": "string", "pattern": "^SZ-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 3},
        "domain": {"type": "string", "enum": ["platform", "emulation", "frontends", "themes", "media", "casting", "online", "ui", "distribution", "governance"]},
        "implementation": {"type": "string", "enum": ["planned", "partial", "complete"]},
        "integration": {"type": "string", "enum": ["isolated", "feature-branch", "staging", "integrated", "released"]},
        "verification": {"type": "string", "enum": ["none", "unit", "dev", "vm", "hw"]},
        "operation": {"type": "string", "enum": ["unknown", "blocked", "degraded", "ready"]},
        "distribution": {"type": "string", "enum": ["not-packaged", "packaged", "installed", "certified"]},
        "scopePaths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^/].*"}, "uniqueItems": true},
        "scopeDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^SZ-[A-Z0-9-]+$"}, "uniqueItems": true},
        "knownGaps": {"type": "array", "items": {"type": "string", "pattern": "^(GAP|LEDGER|DEBT)-[A-Z0-9-]+$"}, "uniqueItems": true},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "nextAction": {"type": "string", "minLength": 5},
        "activeWorkstreams": {"type": "array", "items": {"type": "string", "pattern": "^WS-[A-Z0-9-]+$"}, "uniqueItems": true},
        "updatedAt": {"type": "string", "format": "date"},
        "notes": {"type": "string", "minLength": 5}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "command", "result"],
      "properties": {
        "kind": {"type": "string", "enum": ["test", "vm", "hardware", "diagnostic", "release", "design"]},
        "reference": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["passed", "partial", "failed", "recorded"]}
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "item", "branch", "baseRef", "owner", "state", "exclusivePaths", "sharedPaths", "nextAction", "updatedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "workstream"},
        "id": {"type": "string", "pattern": "^WS-[A-Z0-9-]+$"},
        "item": {"type": "string", "pattern": "^SZ-[A-Z0-9-]+$"},
        "branch": {"type": "string", "pattern": "^codex/[a-z0-9-]+$"},
        "baseRef": {"type": "string", "minLength": 3},
        "owner": {"type": "string", "minLength": 2},
        "state": {"type": "string", "enum": ["active", "blocked", "closed"]},
        "exclusivePaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sharedPaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "nextAction": {"type": "string", "minLength": 5},
        "updatedAt": {"type": "string", "format": "date"}
      }
    }
  }
}
