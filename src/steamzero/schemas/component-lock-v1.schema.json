{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-lock-v1.schema.json",
  "title": "Lockfile de componentes SteamZero",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": {"const": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifestHash", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"$ref": "adapter-v1.schema.json#/$defs/source"}
        }
      }
    }
  }
}
