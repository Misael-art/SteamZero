{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emulation-workspace-v1.schema.json",
  "title": "SteamZero emulation workspace read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "truthState",
    "contextLabel",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "truthState": {
      "$ref": "#/$defs/state"
    },
    "contextLabel": {
      "type": "string",
      "minLength": 1
    },
    "retroExperience": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "contractId",
        "truthState",
        "scalingTable",
        "presets"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "retro-experience-v1"
        },
        "truthState": {
          "const": "declarative"
        },
        "presets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "editorialPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/editorialPlatform"
      }
    },
    "canonicalExperiences": {
      "description": "Identidades históricas do tema; plataformas operacionais continuam em platforms.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/canonicalExperience"
      }
    },
    "globalManagement": {
      "$ref": "#/$defs/globalManagement"
    }
  },
  "$defs": {
    "globalManagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "iconKey",
        "state",
        "statusLabel",
        "technicalPlatformCount",
        "editorialDestinationCount",
        "editorialExperienceCount",
        "editorialSource",
        "platformCards",
        "emulators",
        "directories",
        "mediaProviders"
      ],
      "properties": {
        "id": {
          "const": "emulation-global"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "iconKey": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "technicalPlatformCount": {
          "type": "integer",
          "minimum": 1
        },
        "editorialDestinationCount": {
          "type": "integer",
          "minimum": 1
        },
        "editorialExperienceCount": {
          "type": "integer",
          "minimum": 1
        },
        "editorialSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "detail"
          ],
          "properties": {
            "id": {
              "const": "steam"
            },
            "name": {
              "const": "Steam"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platformCards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/globalPlatformCard"
          }
        },
        "emulators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emulator"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "mediaProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "globalPlatformCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "identity",
        "gameCount",
        "state",
        "readiness",
        "runtime",
        "coreRequired",
        "keysStatus",
        "firmwareStatus",
        "biosStatus",
        "blocker",
        "action",
        "secondaryAction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "gameCount": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "coreRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "keysStatus": {
          "$ref": "#/$defs/requirement"
        },
        "firmwareStatus": {
          "$ref": "#/$defs/requirement"
        },
        "biosStatus": {
          "oneOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "secondaryAction": {
          "oneOf": [
            {
              "$ref": "#/$defs/action"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "editorialPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shortName",
        "games",
        "state",
        "statusLabel",
        "readiness",
        "requirements",
        "subsystems"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "games": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent"
          ],
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": true
        },
        "subsystems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "canonicalExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "groupId",
        "groupName",
        "status",
        "technicalPlatformId",
        "parentId",
        "runtimes",
        "themeKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "hardware",
            "expansion",
            "enhancement",
            "arcade-board",
            "computer",
            "engine",
            "store",
            "cloud"
          ]
        },
        "groupId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "groupName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "enum": [
            "certified",
            "supported",
            "experimental",
            "planned",
            "unavailable"
          ]
        },
        "technicalPlatformId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:+-]{0,95}$"
          }
        },
        "themeKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "type",
        "state",
        "rawState",
        "priority",
        "progress",
        "errorCode",
        "result",
        "canCancel",
        "canRetry",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "rawState": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "type": [
            "object",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {},
        "canCancel": {
          "type": "boolean"
        },
        "canRetry": {
          "type": "boolean"
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "state": {
      "enum": [
        "ready",
        "attention",
        "blocked",
        "unavailable",
        "unverified",
        "planned"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "enabled",
        "reason",
        "requiresConfirmation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9.:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "title",
        "detail",
        "blockers"
      ],
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "iconKey",
        "enabled",
        "reason"
      ],
      "properties": {
        "id": {
          "enum": [
            "global",
            "emulator",
            "game",
            "handheld",
            "dock"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "iconKey": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "iconKey",
        "state",
        "statusLabel",
        "badge"
      ],
      "properties": {
        "id": {
          "enum": [
            "overview",
            "keysFirmware",
            "updatesDlc",
            "modsCheats",
            "graphicsPerformance",
            "controls",
            "saves",
            "shaderCache",
            "media",
            "storage",
            "advanced"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "iconKey": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "badge": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "required",
        "installed",
        "detail",
        "blocksPlay"
      ],
      "properties": {
        "kind": {
          "enum": [
            "keys",
            "firmware",
            "bios"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "outdated",
            "missing",
            "not-required",
            "unverified"
          ]
        },
        "required": {
          "type": [
            "string",
            "null"
          ]
        },
        "installed": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "blocksPlay": {
          "type": "boolean"
        },
        "importAction": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9.-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "emulator": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "displayName",
        "name",
        "platform",
        "state",
        "statusLabel",
        "installState",
        "sourceState",
        "installable",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "installState": {
          "enum": [
            "installed",
            "degraded",
            "not-installed",
            "unverified"
          ]
        },
        "sourceState": {
          "enum": [
            "verified",
            "degraded",
            "unverified",
            "end-of-life"
          ]
        },
        "installable": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "biosRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "biosPresent": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "titleId",
        "name",
        "state",
        "statusLabel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titleId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "emulatorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiresKeys": {
          "type": [
            "object",
            "null"
          ]
        },
        "requiresFirmware": {
          "type": [
            "object",
            "null"
          ]
        },
        "coverUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "platformId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fallbackArtworkUrl": {
          "type": "string"
        },
        "mediaSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "mediaKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "launchReadiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "emulator",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "ready",
                "blocked"
              ]
            },
            "emulator": {
              "enum": [
                "installed",
                "degraded",
                "not-installed",
                "unconfigured",
                "unverified"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "controlsProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "statusLabel",
            "source",
            "scope",
            "active",
            "available",
            "activateActions",
            "clearAction",
            "autoconfig",
            "applyAutoconfigAction"
          ],
          "properties": {
            "state": {
              "enum": [
                "ready",
                "degraded",
                "unverified"
              ]
            },
            "statusLabel": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "game",
                "platform"
              ]
            },
            "scope": {
              "type": "string"
            },
            "active": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true
            },
            "available": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "revision",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "activateActions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id",
                  "label",
                  "enabled",
                  "reason",
                  "requiresConfirmation"
                ]
              }
            },
            "clearAction": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "label",
                    "enabled",
                    "reason",
                    "requiresConfirmation"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "applyAutoconfigAction": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "label",
                    "enabled",
                    "reason",
                    "requiresConfirmation"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "autoconfig": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "statusLabel",
                    "detail",
                    "device",
                    "deviceReason",
                    "autoconfigCandidates",
                    "path",
                    "directoryDeclared",
                    "resolvedBindings",
                    "unresolvedBindings",
                    "withoutRetropadEquivalent"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "not-configured",
                        "awaiting-device",
                        "awaiting-emulator",
                        "pending-write",
                        "partial",
                        "applied",
                        "conflict",
                        "unsupported-scope"
                      ]
                    },
                    "statusLabel": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string"
                    },
                    "device": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "vendorId",
                            "productId"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "vendorId": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "productId": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "deviceReason": {
                      "enum": [
                        "matched",
                        "no-device",
                        "ambiguous-device",
                        "no-autoconfig",
                        "ambiguous-autoconfig"
                      ]
                    },
                    "autoconfigCandidates": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "directoryDeclared": {
                      "type": "boolean"
                    },
                    "resolvedBindings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "action",
                          "input",
                          "key",
                          "value"
                        ],
                        "properties": {
                          "action": {
                            "type": "string",
                            "minLength": 1
                          },
                          "input": {
                            "type": "string",
                            "minLength": 1
                          },
                          "key": {
                            "type": "string",
                            "pattern": "^input_[a-z0-9_]+_(btn|axis)$"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^(?:[+-]?[0-9]+|h[0-9]+(?:up|down|left|right))$"
                          }
                        }
                      }
                    },
                    "unresolvedBindings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "action",
                          "input",
                          "reason",
                          "reasonLabel"
                        ],
                        "properties": {
                          "action": {
                            "type": "string",
                            "minLength": 1
                          },
                          "input": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reason": {
                            "enum": [
                              "entrada-sem-slot-retropad",
                              "dispositivo-nao-declara",
                              "dispositivo-declara-sem-atribuicao",
                              "dispositivo-declara-btn-e-axis",
                              "valor-do-dispositivo-ilegivel"
                            ]
                          },
                          "reasonLabel": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "withoutRetropadEquivalent": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "controlsReadiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "autoconfigState",
            "profileConfigured",
            "controllers"
          ],
          "properties": {
            "state": {
              "enum": [
                "ready",
                "attention"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "autoconfigState": {
              "enum": [
                "not-configured",
                "awaiting-device",
                "awaiting-emulator",
                "pending-write",
                "partial",
                "applied",
                "conflict",
                "unsupported-scope"
              ]
            },
            "profileConfigured": {
              "type": "boolean"
            },
            "controllers": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "contentKind": {
          "const": "base"
        },
        "updateCount": {
          "type": "integer",
          "minimum": 0
        },
        "dlcCount": {
          "type": "integer",
          "minimum": 0
        },
        "updateVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateTarget": {
          "type": "object",
          "additionalProperties": true
        },
        "stateBackups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "stateCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "switch"
              }
            },
            "required": [
              "platform"
            ]
          },
          "then": {
            "properties": {
              "titleId": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9A-F]{16}$"
              }
            }
          }
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "detail",
        "state",
        "statusLabel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "areaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cards",
        "primaryAction"
      ],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "primaryAction": {
          "oneOf": [
            {
              "$ref": "#/$defs/action"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaPipeline": {
          "type": "object",
          "additionalProperties": true
        },
        "libraryRoots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "storageSummary": {
          "type": "object",
          "additionalProperties": true
        },
        "providerCredentials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shortName",
        "iconKey",
        "state",
        "statusLabel",
        "readiness",
        "scopes",
        "selectedScope",
        "areas",
        "selectedArea",
        "emulators",
        "games",
        "requirements",
        "areaData"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "emulated",
            "cloud"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "iconKey": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "statusLabel": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "scopes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "selectedScope": {
          "enum": [
            "global",
            "emulator",
            "game",
            "handheld",
            "dock"
          ]
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/area"
          }
        },
        "selectedArea": {
          "enum": [
            "overview",
            "keysFirmware",
            "updatesDlc",
            "modsCheats",
            "graphicsPerformance",
            "controls",
            "saves",
            "shaderCache",
            "media",
            "storage",
            "advanced"
          ]
        },
        "emulators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emulator"
          }
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game"
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys",
            "firmware"
          ],
          "properties": {
            "keys": {
              "$ref": "#/$defs/requirement"
            },
            "firmware": {
              "$ref": "#/$defs/requirement"
            },
            "bios": {
              "$ref": "#/$defs/requirement"
            }
          }
        },
        "defaultEmulatorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuredDefaultEmulatorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "primaryEmulator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "state",
            "statusLabel",
            "source"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/state"
            },
            "statusLabel": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "configured",
                "configured-unavailable",
                "precedence",
                "none"
              ]
            }
          }
        },
        "fallbackArtworkAsset": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": true
        },
        "controls": {
          "type": "object",
          "additionalProperties": true
        },
        "timing": {
          "type": "object",
          "additionalProperties": true
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "cloud": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "globalSettings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultEmulatorId": {
              "type": "string"
            },
            "autoPublishSteam": {
              "type": "boolean"
            },
            "preferNativeNca": {
              "type": "boolean"
            }
          }
        },
        "runtimeProfiles": {
          "type": "object",
          "additionalProperties": true
        },
        "areaData": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/areaData"
          }
        },
        "launchable": {
          "type": "boolean",
          "description": "Se esta plataforma pode lançar jogos AGORA. Falso não é sinônimo de 'planejado': pode ser emulador ausente, core ausente ou perfil de launch não declarado — launchReason diz qual."
        },
        "launchReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Por que não dá para jogar, quando launchable é falso; null quando dá. Existe para que a UI nunca mostre linha morta sem causa."
        }
      }
    }
  }
}
