{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamzero.org/schemas/game-record-v1.schema.json",
  "title": "SteamZero canonical GameRecord v1",
  "description": "Modelo canônico único de jogo (docs/12-roadmap/AURA-FULLSCREEN-PLATFORM-EXECUTION-PLAN.md §4). Nenhum formato externo vira o modelo dominante; importadores nunca apagam informação mais rica por causa de um formato mais pobre — conflito vira provenance + warnings explícitos. Campos desconhecidos na raiz são tolerados (forward-compat): o modelo evolui por versão de schema, não por descarte silencioso. Roles de mídia são um conjunto fechado desta versão; novo role exige nova versão do schema.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "platformId", "path", "availability", "updatedAt"],
  "additionalProperties": true,
  "maxProperties": 128,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "sortTitle": {"type": "string", "maxLength": 512},
    "aliases": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "platformId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "systemId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "family": {"type": "string", "maxLength": 128},
    "region": {"type": "string", "pattern": "^[a-z]{2,8}(-[a-z0-9]{1,12})?$"},
    "language": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,12})?$"}
    },
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "container": {"type": "string", "pattern": "^[a-z0-9]{1,16}$"},
    "discSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/discEntry"}
    },
    "size": {"type": "integer", "minimum": 0},
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"enum": ["crc32", "md5", "sha1", "sha256", "blake2b"]},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{8,128}$"}
    },
    "developer": {"type": "string", "maxLength": 256},
    "publisher": {"type": "string", "maxLength": 256},
    "releaseDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "genres": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "series": {"type": "string", "maxLength": 256},
    "franchise": {"type": "string", "maxLength": 256},
    "description": {"type": "string", "maxLength": 20000},
    "rating": {"type": "number", "minimum": 0, "maximum": 100},
    "ageRating": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,31}$"},
    "players": {"type": "integer", "minimum": 1, "maximum": 64},
    "features": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 6,
      "properties": {
        "cover": {"$ref": "#/$defs/mediaAsset"},
        "fanart": {"$ref": "#/$defs/mediaAsset"},
        "screenshot": {"$ref": "#/$defs/mediaAsset"},
        "marquee": {"$ref": "#/$defs/mediaAsset"},
        "video": {"$ref": "#/$defs/mediaAsset"},
        "icon": {"$ref": "#/$defs/mediaAsset"}
      }
    },
    "runtime": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "core": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "launchProfile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "emulatorId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "biosRequirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "firmwareRequirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "keyRequirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "controlsProfile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "enhancementProfile": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
    },
    "mods": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "texturePacks": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "saves": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/saveEntry"}
    },
    "saveStates": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/saveEntry"}
    },
    "playtime": {"type": "integer", "minimum": 0},
    "lastPlayed": {"$ref": "#/$defs/timestamp"},
    "favorites": {"type": "boolean"},
    "collections": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": {"$ref": "#/$defs/provenanceEntry"}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}
    },
    "availability": {
      "enum": [
        "available",
        "missing",
        "incompatible",
        "permissionDenied",
        "unknown",
        "degraded",
        "recovery"
      ]
    },
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mediaRole": {
      "enum": ["cover", "fanart", "screenshot", "marquee", "video", "icon"]
    },
    "mediaAsset": {
      "type": "object",
      "required": ["path", "format"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "format": {"enum": ["png", "jpeg", "webp", "svg", "mp4", "webm"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{8,128}$"},
        "width": {"type": "integer", "minimum": 1, "maximum": 32768},
        "height": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "discEntry": {
      "type": "object",
      "required": ["disc", "path"],
      "additionalProperties": false,
      "properties": {
        "disc": {"type": "integer", "minimum": 1, "maximum": 999},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "size": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "maxLength": 256}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "state": {
          "enum": [
            "valid",
            "missing",
            "wrongHash",
            "wrongRegion",
            "incompatible",
            "permissionDenied",
            "unknown"
          ]
        },
        "hash": {"type": "string", "pattern": "^[0-9a-f]{8,128}$"},
        "hashAlgorithm": {"enum": ["crc32", "md5", "sha1", "sha256"]},
        "region": {"type": "string", "pattern": "^[a-z]{2,8}(-[a-z0-9]{1,12})?$"},
        "size": {"type": "integer", "minimum": 0},
        "guidance": {"type": "string", "maxLength": 512}
      }
    },
    "saveEntry": {
      "type": "object",
      "required": ["path", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 999},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "thumbnail": {"type": "string", "minLength": 1, "maxLength": 4096},
        "playtimeSeconds": {"type": "integer", "minimum": 0},
        "compatibility": {"enum": ["native", "emulated", "unknown"]}
      }
    },
    "provenanceEntry": {
      "type": "object",
      "description": "Origem, timestamp, confiança e política de conflito de um campo.",
      "required": ["source", "retrievedAt", "confidence", "conflictPolicy"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "retrievedAt": {"$ref": "#/$defs/timestamp"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "conflictPolicy": {"enum": ["keepRichest", "preferSource", "manual"]}
      }
    }
  }
}
