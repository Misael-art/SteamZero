{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "known-good-profile-v1.schema.json",
  "title": "Catálogo de perfis de configuração conhecidos bons por Title ID",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "platform": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titleId", "settings"],
        "properties": {
          "titleId": {"type": "string", "pattern": "^[0-9A-Fa-f]{16}$"},
          "emulator": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "settings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            }
          }
        }
      }
    }
  }
}
