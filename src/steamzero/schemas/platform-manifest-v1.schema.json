{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-manifest-v1.schema.json",
  "title": "SteamZero platform manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "kind", "name", "shortName", "iconKey",
    "artworkAsset", "systems", "capabilities", "areas", "emulators",
    "media", "controls", "timing", "presets", "cloud"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "kind": {"enum": ["emulated", "cloud"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "shortName": {"type": "string", "minLength": 1, "maxLength": 32},
    "iconKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "artworkAsset": {"type": "string", "pattern": "^\\.\\./assets/[a-z0-9-]+\\.svg$"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/capability"}
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/area"}
    },
    "emulators": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/emulator"}
    },
    "media": {"$ref": "#/$defs/media"},
    "controls": {"$ref": "#/$defs/controls"},
    "timing": {"$ref": "#/$defs/timing"},
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/preset"}
    },
    "cloud": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/cloud"}
      ]
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "requiresConfirmation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9.:-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "requiresConfirmation": {"type": "boolean"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "state", "detail", "action"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,62}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "state": {"enum": ["ready", "planned", "unavailable"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 300},
        "action": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/action"}
          ]
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "iconKey", "capabilityId"],
      "properties": {
        "id": {
          "enum": [
            "overview", "keysFirmware", "updatesDlc", "modsCheats",
            "graphicsPerformance", "controls", "saves", "shaderCache",
            "media", "storage", "advanced"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "iconKey": {"type": "string", "minLength": 1, "maxLength": 64},
        "capabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,62}$"}
      }
    },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "adapterId", "precedence", "role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "adapterId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "precedence": {"type": "integer", "minimum": 1, "maximum": 100},
        "role": {"enum": ["primary", "fallback", "multi-system"]}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "artworkKinds", "providers"],
      "properties": {
        "extensions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]{1,12}$"}
        },
        "artworkKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cover", "background", "logo", "icon", "video"]}
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "maxPlayers", "specialized"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
        },
        "maxPlayers": {"type": "integer", "minimum": 1, "maximum": 16},
        "specialized": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standards", "defaultStandard", "unknownFallback"],
      "properties": {
        "standards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
        },
        "defaultStandard": {"type": ["string", "null"], "maxLength": 63},
        "unknownFallback": {"const": "unknown-explicit"}
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "state", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "state": {"enum": ["ready", "planned", "unavailable"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchUrl", "allowedHosts", "requiresSubscription"],
      "properties": {
        "launchUrl": {"type": "string", "pattern": "^https://[^/]+/?"},
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}
        },
        "requiresSubscription": {"type": "boolean"}
      }
    }
  }
}
