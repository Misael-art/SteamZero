{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gtool-launch-environment-v1.schema.json",
  "title": "SteamZero pure launch environment composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layers", "managedKeys", "collisionPolicy", "shell"],
  "properties": {
    "schemaVersion": {"const": 1},
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
    },
    "managedKeys": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
    },
    "collisionPolicy": {"const": "reject"},
    "shell": {"const": false}
  }
}
