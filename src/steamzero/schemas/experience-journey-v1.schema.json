{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience-journey-v1.schema.json",
  "title": "SteamZero Experience Journey v1",
  "description": "Menus, declared routes, public read-model filters and per-stage appearance. Session actions remain semantic adapter contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "entryMenuId", "organization", "menus", "connections", "sessionStages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "steamzero-experience-journey-v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "entryMenuId": {"$ref": "#/$defs/id"},
    "organization": {
      "type": "array",
      "maxItems": 8192,
      "items": {"$ref": "#/$defs/organizationNode"}
    },
    "menus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/menu"}
    },
    "connections": {
      "type": "array",
      "maxItems": 16384,
      "items": {"$ref": "#/$defs/connection"}
    },
    "sessionStages": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sessionStage"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "publicFieldId": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_.-]{0,127}$"},
    "appearance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "themeId"],
          "properties": {
            "mode": {"const": "custom"},
            "themeId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "inherit-aura"}}
        }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "operator"],
      "properties": {
        "fieldId": {"$ref": "#/$defs/publicFieldId"},
        "operator": {"enum": ["equals", "notEquals", "oneOf", "contains", "greaterThanOrEqual", "lessThanOrEqual", "isKnown", "isUnknown"]},
        "value": {
          "oneOf": [
            {"type": ["string", "number", "integer", "boolean", "null"]},
            {"type": "array", "items": {"type": ["string", "number", "integer", "boolean", "null"]}, "maxItems": 256, "uniqueItems": true}
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"operator": {"enum": ["isKnown", "isUnknown"]}}}, "then": {"not": {"required": ["value"]}}},
        {"if": {"properties": {"operator": {"enum": ["equals", "notEquals", "contains", "greaterThanOrEqual", "lessThanOrEqual"]}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"operator": {"const": "oneOf"}}}, "then": {"required": ["value"], "properties": {"value": {"type": "array", "minItems": 1}}}}
      ]
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "direction"],
      "properties": {
        "fieldId": {"$ref": "#/$defs/publicFieldId"},
        "direction": {"enum": ["ascending", "descending"]}
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "filters", "sort"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readModelId"],
          "properties": {"readModelId": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_.-]{1,127}$"}}
        },
        "filters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/filter"}},
        "sort": {"type": "array", "items": {"$ref": "#/$defs/sort"}},
        "appearance": {"$ref": "#/$defs/appearance"}
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "menu"}, "id": {"$ref": "#/$defs/id"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {"kind": {"const": "stage"}, "id": {"enum": ["entryFade", "gameplay", "pause", "saves", "bezel", "osd", "exitFade", "loading", "empty", "error", "offline"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "history"}}
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "event", "when", "action", "to", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/endpoint"},
        "event": {"enum": ["select", "back", "play", "pause", "resume", "open-saves", "save", "load", "exit", "retry"]},
        "when": {"enum": ["user-input", "operation-success", "operation-failure", "timeout"]},
        "action": {"enum": ["navigate", "back", "launch", "pause", "resume", "open-saves", "save", "load", "exit", "retry"]},
        "to": {"$ref": "#/$defs/endpoint"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "organizationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "parentId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["group", "menu"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "parentId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "menuId": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "menu"}}}, "then": {"required": ["menuId"]}},
        {"if": {"properties": {"kind": {"const": "group"}}}, "then": {"not": {"required": ["menuId"]}}}
      ]
    },
    "sessionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId"],
      "properties": {
        "stageId": {"enum": ["entryFade", "gameplay", "pause", "saves", "bezel", "osd", "exitFade", "loading", "empty", "error", "offline"]},
        "appearance": {"$ref": "#/$defs/appearance"}
      }
    }
  }
}
