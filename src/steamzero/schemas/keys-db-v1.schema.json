{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keys-db-v1.schema.json",
  "title": "Banco de hashes de keysets — só hashes/metadados, nunca conteúdo de key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "keyset", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "platform": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "keyset": {"enum": ["prod", "title", "dev"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "keyRevision"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "keyRevision": {"type": "integer", "minimum": 0, "maximum": 255},
          "label": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    }
  }
}
