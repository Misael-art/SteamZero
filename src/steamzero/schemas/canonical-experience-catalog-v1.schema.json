{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-experience-catalog-v1.schema.json",
  "title": "SteamZero canonical experience catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "experiences"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "experiences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/experience" }
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "status", "technicalPlatformId", "parentId", "runtimes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": {
          "enum": [
            "hardware", "expansion", "enhancement", "arcade-board",
            "computer", "engine", "store", "cloud"
          ]
        },
        "status": {
          "enum": ["certified", "supported", "experimental", "planned", "unavailable"]
        },
        "technicalPlatformId": {
          "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }]
        },
        "parentId": {
          "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }]
        },
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:+-]{0,95}$"
          }
        }
      }
    }
  }
}
