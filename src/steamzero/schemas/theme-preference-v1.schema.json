{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamzero.org/schemas/theme-preference-v1.schema.json",
  "title": "Theme Preference v1",
  "description": "Preferência de tema ativo do usuário.",
  "type": "object",
  "required": ["schemaVersion", "themeId", "themeVersion"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "themeVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
