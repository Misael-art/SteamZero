{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bios-catalog-v2.schema.json",
  "title": "SteamZero BIOS catalog v2 (metadata and hashes only)",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 2},
    "entries": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "platformId", "canonicalName", "namingAuthority", "acceptedVariants", "consumers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"},
          "platformId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "canonicalName": {"type": "string", "minLength": 1, "maxLength": 255},
          "namingAuthority": {"type": "string", "minLength": 1, "maxLength": 64},
          "required": {"type": "boolean"},
          "group": {"type": "string", "pattern": "^(allOf|anyOf):[a-z0-9.-]+$"},
          "acceptedVariants": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["sha256", "size"], "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 1},
              "region": {"type": "string"}, "revision": {"type": "string"},
              "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
            }, "additionalProperties": false}
          },
          "consumers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["adapterId", "relativePath"], "properties": {
            "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "coreId": {"type": "string"}, "relativePath": {"type": "string", "minLength": 1},
            "required": {"type": "boolean"}, "projectionModes": {"type": "array", "items": {"enum": ["symlink", "read-only-store", "bind-mount", "materialized-copy"]}}
          }, "additionalProperties": false}},
          "notes": {"type": "string", "maxLength": 2048}
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
