{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gtool-hud-v1.schema.json",
  "title": "SteamZero HUD catalog and automated evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewport", "runtime", "presets", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"const": 1280}, "height": {"const": 800}}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "tool", "detail"],
      "properties": {
        "state": {"enum": ["ready", "unavailable", "unverified"]},
        "tool": {"const": "MangoHud"},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "presets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/preset"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "state", "proves", "doesNotProve", "humanReview"],
      "properties": {
        "method": {"const": "deterministic-layout-budget"},
        "state": {"const": "verified-offscreen"},
        "proves": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "doesNotProve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "humanReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "items"],
          "properties": {
            "state": {"const": "PENDING-HUMAN"},
            "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "mode", "config", "metrics", "layout"],
      "properties": {
        "id": {"enum": ["compact", "detailed"]},
        "label": {"type": "string", "minLength": 1},
        "mode": {"enum": ["basic", "detailed"]},
        "config": {"type": "string", "minLength": 1},
        "metrics": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "maxWidth", "maxHeight", "margin", "fitsViewport"],
          "properties": {
            "anchor": {"const": "top-left"},
            "maxWidth": {"type": "integer", "minimum": 1, "maximum": 1280},
            "maxHeight": {"type": "integer", "minimum": 1, "maximum": 800},
            "margin": {"type": "integer", "minimum": 0},
            "fitsViewport": {"const": true}
          }
        }
      }
    }
  }
}
