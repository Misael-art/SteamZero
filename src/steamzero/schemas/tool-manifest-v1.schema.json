{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-manifest-v1.schema.json",
  "title": "Manifesto de ferramenta de conversão — fontes pinadas com hash",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "conversions", "sources", "license", "upstream"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "kind": {"const": "converter"},
    "conversions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "pattern": "^[a-z0-9][a-z0-9]{0,15}$"},
          "to": {"type": "string", "pattern": "^[a-z0-9][a-z0-9]{0,15}$"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "version", "priority", "sha256"],
        "properties": {
          "type": {"enum": ["pip", "appimage", "native"]},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
          "priority": {"type": "integer", "minimum": 1},
          "ref": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "smokeTest": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "license": {"type": "string", "minLength": 1},
    "upstream": {"type": "string", "format": "uri"},
    "notes": {"type": "string"}
  }
}
