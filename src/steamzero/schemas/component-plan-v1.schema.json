{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-plan-v1.schema.json",
  "title": "Plano de implantação Flatpak pinada",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "confirmToken",
    "adapterId",
    "ref",
    "remote",
    "targetCommit",
    "before",
    "action",
    "status",
    "createdAt",
    "expiresAt",
    "rollbackGuarantee",
    "preview"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "planId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "confirmToken": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "ref": {"type": "string", "minLength": 1},
    "remote": {"type": "string", "minLength": 1},
    "targetCommit": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installed", "ref", "origin", "commit"],
      "properties": {
        "installed": {"type": "boolean"},
        "ref": {"type": "string"},
        "origin": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "action": {"enum": ["install", "update", "noop"]},
    "status": {"enum": ["pending", "applied", "aborted"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "rollbackGuarantee": {"const": "G-DEPLOYMENT"},
    "preview": {"type": "string", "minLength": 1}
  }
}
