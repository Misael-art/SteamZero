{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamzero.org/schemas/scene-layout-v1.schema.json",
  "title": "Theme Engine scene layouts v1",
  "description": "Layouts e repetidores declarativos; o tema descreve geometria e bindings item.*, nunca código.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layouts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-zA-Z0-9]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/layout"}
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kind", "item", "template"],
      "properties": {
        "source": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,31}(?:\\.[a-z][a-zA-Z0-9]{0,31}){1,3}$", "maxLength": 128},
        "kind": {"enum": ["grid", "list"]},
        "item": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": {"width": {"type": "number", "minimum": 1, "maximum": 2048}, "height": {"type": "number", "minimum": 1, "maximum": 2048}}
        },
        "template": {"$ref": "#/$defs/template"},
        "gap": {"type": "number", "minimum": 0, "maximum": 256},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 128},
        "columns": {"type": "integer", "minimum": 1, "maximum": 16},
        "direction": {"enum": ["vertical", "horizontal"]},
        "breakpoints": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/breakpoint"}}
      }
    },
    "breakpoint": {
      "type": "object", "additionalProperties": false, "required": ["columns"],
      "properties": {"columns": {"type": "integer", "minimum": 1, "maximum": 16}, "minWidth": {"type": "number", "minimum": 0, "maximum": 16384}, "maxWidth": {"type": "number", "minimum": 0, "maximum": 16384}}
    },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["text", "image"]},
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]{0,63}$"},
        "properties": {"type": "object", "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/property"}}
      }
    },
    "property": {
      "oneOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {"type": "object", "additionalProperties": false, "required": ["binding"], "properties": {"binding": {"type": "string", "pattern": "^item\\.[a-z][a-zA-Z0-9]{0,31}(?:\\.[a-z][a-zA-Z0-9]{0,31})?$"}, "fallback": {"type": ["string", "number", "integer", "boolean", "null"]}}}
      ]
    }
  }
}
