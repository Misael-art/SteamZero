{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feat-bitrot-v1.schema.json",
  "title": "SteamZero bounded collection integrity read model v1",
  "type": "object",
  "required": [
    "schemaVersion", "generatedAt", "state", "lastRun", "counts",
    "items", "activeJobs", "limits"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["healthy", "suspect", "unchecked"]},
    "lastRun": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["startedAt", "finishedAt", "checked", "bytesRead", "suspect", "limited"],
          "properties": {
            "startedAt": {"type": "string", "format": "date-time"},
            "finishedAt": {"type": "string", "format": "date-time"},
            "checked": {"type": "integer", "minimum": 0},
            "bytesRead": {"type": "integer", "minimum": 0},
            "suspect": {"type": "integer", "minimum": 0},
            "limited": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      ]
    },
    "counts": {
      "type": "object",
      "required": ["verified", "suspect", "missing", "error", "unavailable", "unchecked"],
      "properties": {
        "verified": {"type": "integer", "minimum": 0},
        "suspect": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0},
        "unchecked": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["assetId", "title", "platformId", "state", "size", "checkedAt", "reason"],
        "properties": {
          "assetId": {"type": "string", "minLength": 1, "maxLength": 160},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "platformId": {"type": "string", "minLength": 1, "maxLength": 96},
          "state": {"enum": ["verified", "suspect", "missing", "error", "unavailable"]},
          "size": {"type": "integer", "minimum": 0},
          "checkedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "maxLength": 240}
        },
        "additionalProperties": false
      }
    },
    "activeJobs": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "object"}
    },
    "limits": {
      "type": "object",
      "required": ["maxFiles", "maxBytes", "maxSeconds"],
      "properties": {
        "maxFiles": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxBytes": {"type": "integer", "minimum": 1024, "maximum": 17179869184},
        "maxSeconds": {"type": "number", "minimum": 0.1, "maximum": 120}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
