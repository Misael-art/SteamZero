{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamzero.org/schemas/scene-motion-v1.schema.json",
  "title": "Theme Engine scene motion v1",
  "description": "Estados nativos, transições e timeline declarativos; o pacote nunca fornece QML, JS ou easing arbitrário.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": {"const": 1},
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "normal": {"$ref": "#/$defs/snapshot"},
        "focused": {"$ref": "#/$defs/snapshot"},
        "selected": {"$ref": "#/$defs/snapshot"},
        "pressed": {"$ref": "#/$defs/snapshot"},
        "disabled": {"$ref": "#/$defs/snapshot"},
        "loading": {"$ref": "#/$defs/snapshot"},
        "missing": {"$ref": "#/$defs/snapshot"},
        "error": {"$ref": "#/$defs/snapshot"},
        "offline": {"$ref": "#/$defs/snapshot"},
        "playing": {"$ref": "#/$defs/snapshot"},
        "idle": {"$ref": "#/$defs/snapshot"},
        "menuOpen": {"$ref": "#/$defs/snapshot"}
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/transition"}
    },
    "timelines": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[a-z][a-zA-Z0-9]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/timeline"}
    }
  },
  "$defs": {
    "stateName": {
      "enum": ["normal", "focused", "selected", "pressed", "disabled", "loading", "missing", "error", "offline", "playing", "idle", "menuOpen"]
    },
    "easing": {
      "enum": [
        "linear",
        "quadIn", "quadOut", "quadInOut",
        "cubicIn", "cubicOut", "cubicInOut",
        "quartIn", "quartOut", "quartInOut",
        "quintIn", "quintOut", "quintInOut",
        "expoIn", "expoOut", "expoInOut",
        "circIn", "circOut", "circInOut",
        "backIn", "backOut", "backInOut",
        "elasticIn", "elasticOut", "elasticInOut",
        "bounceIn", "bounceOut", "bounceInOut",
        "cubicBezier"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "scale": {"type": "number", "minimum": 0.5, "maximum": 2},
        "translateX": {"type": "number", "minimum": -256, "maximum": 256},
        "translateY": {"type": "number", "minimum": -256, "maximum": 256}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "duration", "easing"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"},
        "from": {"$ref": "#/$defs/stateName"},
        "to": {"$ref": "#/$defs/stateName"},
        "duration": {"type": "integer", "minimum": 0, "maximum": 2000},
        "easing": {"$ref": "#/$defs/easing"},
        "essential": {"type": "boolean"},
        "x1": {"type": "number", "minimum": 0, "maximum": 1},
        "y1": {"type": "number", "minimum": -2, "maximum": 2},
        "x2": {"type": "number", "minimum": 0, "maximum": 1},
        "y2": {"type": "number", "minimum": -2, "maximum": 2}
      }
    },
    "clip": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "duration"],
          "properties": {
            "state": {"$ref": "#/$defs/stateName"},
            "duration": {"type": "integer", "minimum": 0, "maximum": 2000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transition"],
          "properties": {
            "transition": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"}
          }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "clips"],
      "properties": {
        "kind": {"enum": ["sequence", "parallel"]},
        "repeat": {"type": "integer", "minimum": 0, "maximum": 8},
        "clips": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/clip"}}
      }
    }
  }
}
