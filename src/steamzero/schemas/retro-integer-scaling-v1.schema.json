{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retro-integer-scaling-v1.schema.json",
  "title": "SteamZero normative retro integer scaling table v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tableId", "policy", "viewport", "rows"],
  "properties": {
    "schemaVersion": {"const": 1},
    "tableId": {"const": "retro-integer-scaling-v1"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback", "stretch", "crop"],
      "properties": {
        "primary": {"const": "largest-integer-fit"},
        "fallback": {"const": "sharp-bilinear"},
        "stretch": {"const": false},
        "crop": {"const": false}
      }
    },
    "viewport": {"$ref": "#/$defs/dimensions"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "height": {"type": "integer", "minimum": 1, "maximum": 8192}
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "filter", "integerScale", "outputWidth", "outputHeight",
        "marginX", "marginY", "coveragePermille", "reason"
      ],
      "properties": {
        "mode": {"enum": ["integer", "sharp-bilinear"]},
        "filter": {"enum": ["nearest", "sharp-bilinear"]},
        "integerScale": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 8192
        },
        "outputWidth": {"type": "integer", "minimum": 1, "maximum": 8192},
        "outputHeight": {"type": "integer", "minimum": 1, "maximum": 8192},
        "marginX": {"type": "integer", "minimum": 0, "maximum": 8191},
        "marginY": {"type": "integer", "minimum": 0, "maximum": 8191},
        "coveragePermille": {"type": "integer", "minimum": 1, "maximum": 1000},
        "reason": {"enum": ["largest-integer-fit", "source-exceeds-viewport"]}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "filter", "outputWidth", "outputHeight", "reason"],
      "properties": {
        "mode": {"const": "sharp-bilinear"},
        "filter": {"const": "sharp-bilinear"},
        "outputWidth": {"type": "integer", "minimum": 1, "maximum": 8192},
        "outputHeight": {"type": "integer", "minimum": 1, "maximum": 8192},
        "reason": {"const": "fill-or-downscale-only"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemId", "modeId", "source", "viewport", "selected", "fallback"
      ],
      "properties": {
        "systemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "modeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "source": {"$ref": "#/$defs/dimensions"},
        "viewport": {"$ref": "#/$defs/dimensions"},
        "selected": {"$ref": "#/$defs/selected"},
        "fallback": {"$ref": "#/$defs/fallback"}
      }
    }
  }
}
