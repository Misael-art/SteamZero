{
  "schemaVersion": 1,
  "id": "mega-drive-3-button",
  "revision": 1,
  "label": "Mega Drive — 3 botões",
  "platforms": ["mega-drive"],
  "source": {"kind": "builtin", "license": "GPL-3.0-or-later"},
  "layout": "three-button",
  "maxPlayers": 4,
  "bindings": [
    {"action": "game.up", "input": "hat.up", "required": true},
    {"action": "game.right", "input": "hat.right", "required": true},
    {"action": "game.down", "input": "hat.down", "required": true},
    {"action": "game.left", "input": "hat.left", "required": true},
    {"action": "game.primary", "input": "button.west", "required": true},
    {"action": "game.secondary", "input": "button.south", "required": true},
    {"action": "game.tertiary", "input": "button.east", "required": true},
    {"action": "game.start", "input": "button.start", "required": true}
  ],
  "rotation": {
    "allowedOrientations": ["landscape", "portrait-left", "portrait-right"],
    "defaultOrientation": "landscape",
    "directionalRemap": "rotate-with-display"
  }
}
