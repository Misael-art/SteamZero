{
  "schemaVersion": 1,
  "id": "vita-handheld",
  "revision": 1,
  "label": "PS Vita portátil",
  "platforms": ["playstation-vita"],
  "source": {"kind": "builtin", "license": "GPL-3.0-or-later"},
  "layout": "standard-gamepad",
  "maxPlayers": 1,
  "bindings": [
    {"action": "game.up", "input": "hat.up", "required": true},
    {"action": "game.right", "input": "hat.right", "required": true},
    {"action": "game.down", "input": "hat.down", "required": true},
    {"action": "game.left", "input": "hat.left", "required": true},
    {"action": "game.primary", "input": "button.south", "required": true},
    {"action": "game.secondary", "input": "button.east", "required": true},
    {"action": "game.tertiary", "input": "button.west", "required": true},
    {"action": "game.quaternary", "input": "button.north", "required": true},
    {"action": "game.start", "input": "button.start", "required": true},
    {"action": "game.select", "input": "button.select", "required": true},
    {"action": "game.axis-x", "input": "axis.left-x", "required": true},
    {"action": "game.axis-y", "input": "axis.left-y", "required": true},
    {"action": "game.axis-rx", "input": "axis.right-x", "required": false},
    {"action": "game.axis-ry", "input": "axis.right-y", "required": false}
  ],
  "rotation": {"allowedOrientations": ["landscape"], "defaultOrientation": "landscape", "directionalRemap": "preserve"}
}
