{
  "schemaVersion": 1,
  "id": "retroarch",
  "kind": "emulator",
  "presentation": {
    "displayName": "RetroArch",
    "iconAsset": "../assets/retroarch.svg"
  },
  "platforms": [
    "multi"
  ],
  "capabilities": [
    "detect",
    "status",
    "install",
    "update",
    "uninstall",
    "configure",
    "verify",
    "repair",
    "backup",
    "restore"
  ],
  "sources": [
    {
      "type": "flatpak",
      "ref": "org.libretro.RetroArch",
      "remote": "flathub",
      "version": "8654e66b8ee5f76f5fc488890fb41093f4bb12109a2bb94836549d844625f288",
      "priority": 1
    }
  ],
  "paths": {
    "config": "{XDG_CONFIG_HOME}/retroarch/retroarch.cfg"
  },
  "configFormat": "ini",
  "verify": {
    "smokeTest": [
      "--version"
    ]
  },
  "compat": [
    "steamos",
    "bazzite",
    "linux"
  ],
  "license": "GPL-3.0-only",
  "upstream": "https://github.com/libretro/RetroArch"
}
