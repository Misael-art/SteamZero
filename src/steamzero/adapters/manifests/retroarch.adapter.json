{
  "schemaVersion": 1,
  "id": "retroarch",
  "kind": "emulator",
  "presentation": {
    "displayName": "RetroArch",
    "iconAsset": "../assets/retroarch.svg"
  },
  "platforms": [
    "multi"
  ],
  "capabilities": [
    "detect",
    "status",
    "install",
    "update",
    "uninstall",
    "configure",
    "verify",
    "repair",
    "backup",
    "restore"
  ],
  "sources": [
    {
      "type": "flatpak",
      "ref": "org.libretro.RetroArch",
      "remote": "flathub",
      "version": "d8644a97df3db3cdd46eff2f7aea7d429c40f7e1e7ed5788a191714cc29a74a8",
      "priority": 1
    }
  ],
  "paths": {
    "config": "{XDG_CONFIG_HOME}/retroarch/retroarch.cfg"
  },
  "configFormat": "ini",
  "verify": {
    "smokeTest": [
      "--version"
    ]
  },
  "compat": [
    "steamos",
    "bazzite",
    "linux"
  ],
  "license": "GPL-3.0-only",
  "upstream": "https://github.com/libretro/RetroArch"
}
