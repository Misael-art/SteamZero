{
  "schemaVersion": 1,
  "id": "retroarch",
  "kind": "emulator",
  "presentation": {
    "displayName": "RetroArch",
    "iconAsset": "../assets/retroarch.svg"
  },
  "platforms": [
    "multi"
  ],
  "capabilities": [
    "detect",
    "status",
    "install",
    "update",
    "uninstall",
    "configure",
    "verify",
    "repair",
    "backup",
    "restore"
  ],
  "sources": [
  {
    "type": "flatpak",
    "ref": "org.libretro.RetroArch",
    "remote": "flathub",
    "version": "9c51e2bcb6f7f29ecb327ee057b273c5b59efc22d35026e90aef601bc0052752",
    "priority": 1
  }
  ],
  "paths": {
    "config": "{XDG_CONFIG_HOME}/retroarch/retroarch.cfg"
  },
  "configFormat": "ini",
  "verify": {
    "smokeTest": [
      "--version"
    ]
  },
  "compat": [
    "steamos",
    "bazzite",
    "linux"
  ],
  "license": "GPL-3.0-only",
  "upstream": "https://github.com/libretro/RetroArch"
}
