{
  "schemaVersion": 1,
  "id": "cemu",
  "kind": "emulator",
  "presentation": {
    "displayName": "Cemu",
    "iconAsset": "../assets/wii-u.svg"
  },
  "platforms": [
    "wii-u"
  ],
  "capabilities": [
    "detect",
    "status",
    "install",
    "update",
    "uninstall",
