{
  "schemaVersion": 1,
  "kind": "steamzero-theme-v1",
  "id": "org.steamzero.asset-recipes-demo",
  "name": "Theme Engine — asset único",
  "version": "1.0.0",
  "author": "SteamZero contributors",
  "license": "CC0-1.0",
  "description": "Fixture original e redistribuível para provar variantes geradas em runtime a partir de uma única fonte transparente.",
  "compatibility": { "themeApi": 1 },
  "extends": "org.steamzero.default",
  "assets": {
    "logo": "assets/source.svg"
  },
  "sceneLayouts": {
    "schemaVersion": 1,
    "layouts": {
      "previewTitles": {
        "source": "preview.items",
        "kind": "grid",
        "item": { "width": 138, "height": 32 },
        "gap": 8,
        "maxItems": 4,
        "breakpoints": [
          { "maxWidth": 479, "columns": 2 },
          { "minWidth": 480, "columns": 4 }
        ],
        "template": {
          "kind": "text",
          "id": "preview-title",
          "properties": {
            "text": { "binding": "item.title", "fallback": "Sem título" },
            "color": "#f2f6fb",
            "fontPixelSize": 14
          }
        }
      },
      "previewWheel": {
        "source": "preview.items",
        "kind": "wheel",
        "item": { "width": 138, "height": 32 },
        "gap": 10,
        "maxItems": 4,
        "selected": 1,
        "offset": {
          "scaleStep": 0.08,
          "opacityStep": 0.18,
          "minScale": 0.7,
          "minOpacity": 0.35
        },
        "template": {
          "kind": "text",
          "id": "wheel-title",
          "properties": {
            "text": { "binding": "item.title", "fallback": "Sem título" },
            "color": "#f2f6fb",
            "fontPixelSize": 14
          }
        }
      }
    }
  },
  "dynamicPalette": {
    "schemaVersion": 1,
    "sourceSlot": "logo",
    "algorithm": "medianCut",
    "fallback": {
      "dominant": "#132833",
      "vibrant": "#22d3ee",
      "lightVibrant": "#7dd3fc",
      "darkVibrant": "#0e7490",
      "muted": "#64748b",
      "lightMuted": "#94a3b8",
      "darkMuted": "#334155",
      "complementary": "#ee3d22",
      "accent": "#22d3ee",
      "background": "#071019",
      "contrastText": "#f2f6fb"
    }
  },
  "glass": {
    "schemaVersion": 1,
    "panels": {
      "previewCard": {
        "blur": 24,
        "tint": { "binding": "palette.accent", "fallback": "#132833" },
        "tintOpacity": 0.42,
        "borderColor": "#ffffff",
        "borderOpacity": 0.28,
        "highlightOpacity": 0.16,
        "shadowOpacity": 0.32,
        "sampleScale": 0.5,
        "fallback": "flat"
      }
    }
  },
  "sceneMotion": {
    "schemaVersion": 1,
    "states": {
      "normal": { "opacity": 1, "scale": 1 },
      "focused": { "opacity": 1, "scale": 1.06 },
      "selected": { "opacity": 1, "scale": 1.04 },
      "pressed": { "opacity": 0.92, "scale": 0.98 },
      "disabled": { "opacity": 0.45 }
    },
    "transitions": [
      {
        "id": "focusIn",
        "from": "normal",
        "to": "focused",
        "duration": 180,
        "easing": "cubicOut",
        "essential": false
      },
      {
        "id": "errorFlash",
        "from": "normal",
        "to": "error",
        "duration": 90,
        "easing": "linear",
        "essential": true
      }
    ],
    "timelines": {
      "previewFocus": {
        "kind": "sequence",
        "repeat": 0,
        "clips": [
          { "state": "normal", "duration": 0 },
          { "transition": "focusIn" },
          { "state": "focused", "duration": 80 }
        ]
      }
    }
  },
  "sceneSurfaces": {
    "schemaVersion": 1,
    "slots": {
      "home": { "component": "recentRail" },
      "library": { "component": "libraryGrid" },
      "saveStates": { "component": "saveGallery" },
      "osd": { "component": "quickOsd" },
      "error": { "component": "errorBanner" }
    },
    "components": {
      "recentRail": { "kind": "recentlyPlayed", "source": "library.recent" },
      "libraryGrid": { "kind": "gameGrid", "source": "library.items" },
      "saveGallery": { "kind": "saveGallery", "source": "saves.slots", "maxItems": 4 },
      "quickOsd": {
        "kind": "osd",
        "items": ["volume", "mute", "pause", "saveState"],
        "progress": { "binding": "osd.volume", "fallback": 0 }
      },
      "errorBanner": { "kind": "errorBanner" }
    }
  },
  "assetRecipes": {
    "schemaVersion": 1,
    "sourceSlot": "logo",
    "recipes": {
      "original": {
        "source": "logo",
        "nodes": []
      },
      "colored": {
        "source": "logo",
        "nodes": [
          { "type": "recolor", "color": "#22d3ee", "opacity": 1, "fallback": "source" }
        ]
      },
      "grayscale": {
        "source": "logo",
        "nodes": [
          { "type": "grayscale", "amount": 1, "fallback": "source" }
        ]
      },
      "black": {
        "source": "logo",
        "nodes": [
          { "type": "silhouette", "color": "#000000", "opacity": 1, "fallback": "source" }
        ]
      },
      "white": {
        "source": "logo",
        "nodes": [
          { "type": "silhouette", "color": "#ffffff", "opacity": 1, "fallback": "source" }
        ]
      },
      "invert": {
        "source": "logo",
        "nodes": [
          { "type": "invert", "amount": 1, "fallback": "source" }
        ]
      },
      "hueShift": {
        "source": "logo",
        "nodes": [
          { "type": "hueRotate", "degrees": 120, "fallback": "source" }
        ]
      },
      "outlineThin": {
        "source": "logo",
        "nodes": [
          { "type": "outline", "width": 2, "color": "#ffffff", "opacity": 1, "position": "outer", "mask": "alpha", "fallback": "outer" }
        ]
      },
      "outlineThick": {
        "source": "logo",
        "nodes": [
          { "type": "outline", "width": 8, "color": "#000000", "opacity": 1, "position": "outer", "mask": "alpha", "fallback": "outer" }
        ]
      },
      "outlineInner": {
        "source": "logo",
        "nodes": [
          { "type": "outline", "width": 3, "color": "#ffffff", "opacity": 0.9, "position": "inner", "mask": "alpha", "fallback": "outer" }
        ]
      },
      "outlinedGlow": {
        "source": "logo",
        "nodes": [
          { "type": "recolor", "color": "#22d3ee", "opacity": 1, "fallback": "source" },
          { "type": "outline", "width": 3, "color": "#ffffff", "opacity": 0.9, "position": "outer", "mask": "alpha", "fallback": "outer" },
          { "type": "glow", "color": "#22d3ee", "strength": 0.55, "blur": 18, "fallback": "source" }
        ]
      },
      "outlinedShadow": {
        "source": "logo",
        "nodes": [
          { "type": "outline", "width": 3, "color": "#ffffff", "opacity": 1, "position": "outer", "mask": "alpha", "fallback": "outer" },
          { "type": "shadow", "color": "#000000", "opacity": 0.7, "blur": 10, "offsetX": 4, "offsetY": 6, "fallback": "source" }
        ]
      }
    }
  }
}
